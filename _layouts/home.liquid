---
layout: default
---
{% assign home = site.data.home %}
{% assign hero = home.hero %}
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Noto+Serif+SC:wght@400&display=swap&text={{ hero.zh | append: home.play.music.title | url_encode }}">

<div class="home" data-home>
  <!-- 1. Hero -->
  <header class="home-hero home-sect">
    <div class="home-hero__text">
      <!-- The name, set like a proof: crop marks at the corners, a brush
           underline (where the red thread begins), and the Chinese name as a seal. -->
      <div class="home-nameplate">
        <span class="home-crop home-crop--tl" aria-hidden="true"></span>
        <span class="home-crop home-crop--tr" aria-hidden="true"></span>
        <span class="home-crop home-crop--bl" aria-hidden="true"></span>
        <span class="home-crop home-crop--br" aria-hidden="true"></span>
        <h1 class="home-name home-r" aria-label="{{ hero.first }} {{ hero.last }}">
          <span class="home-name__row" aria-hidden="true">{{ hero.first }}</span>
          <em class="home-name__row" aria-hidden="true">{{ hero.last }}<svg class="home-swash" viewBox="0 0 300 36" preserveAspectRatio="none" aria-hidden="true"><path d="M3,24 C48,30 110,17 168,15 C214,13 258,18 297,9"></path></svg></em>
        </h1>
        <span class="home-seal home-zh" lang="zh" title="{{ hero.zh }}">{{ hero.zh }}</span>
      </div>
      <p class="home-hero__line home-r" style="--d: 0.55s">{{ hero.line }}</p>
    </div>
    <div class="home-print-wrap home-r" style="--d: 0.4s">
      <figure class="home-print">
        <div class="home-print__frame">
          <img
            src="{{ 'assets/img/prof_pic-800.webp' | relative_url }}"
            srcset="{{ 'assets/img/prof_pic-480.webp' | relative_url }} 480w, {{ 'assets/img/prof_pic-800.webp' | relative_url }} 800w"
            sizes="(min-width: 860px) 320px, 70vw"
            alt="Rohan Prasad"
            width="800"
            height="1200"
            loading="eager"
          >
        </div>
        <figcaption>{{ hero.caption }}</figcaption>
      </figure>
    </div>
  </header>

  <!-- 2. Now -->
  {% assign now = home.now %}
  {% assign needle = '_posts/' | append: now.post | append: '.md' %}
  {% assign now_post = site.posts | where: 'path', needle | first %}
  <section class="home-now home-sect" aria-labelledby="home-now">
    <div class="home-now__card">
      <div class="home-now__brand">
        <div class="home-label home-r" id="home-now">{{ now.label }}</div>
        <div class="home-now__lockup home-r" style="--d: 0.1s">
          {% if now.logo %}<img class="home-now__logo" src="{{ '/assets/img/' | append: now.logo | relative_url }}" alt="Sapiens First logo" width="192" height="192" loading="lazy" decoding="async">{% endif %}
          <div class="home-now__big">{{ now.big[0] }}<br><em>{{ now.big[1] }}</em></div>
        </div>
      </div>
      <div class="home-now__body">
        <p class="home-lead home-r" style="--d: 0.25s">{{ now.line }}</p>
        <a class="home-btn home-btn--light home-r" style="--d: 0.35s" href="{{ now.button.url }}">{{ now.button.text }} <span aria-hidden="true">→</span></a>
        {% if now_post %}
          <a class="home-now__post home-r" style="--d: 0.45s" href="{{ now_post.url | relative_url }}">
            <span class="home-now__post-k">{{ now.post_label | default: 'Read' }} · {{ now_post.date | date: '%B %Y' }}</span>
            <span class="home-now__post-t">{{ now_post.title }} <span aria-hidden="true">→</span></span>
          </a>
        {% endif %}
      </div>
    </div>
  </section>

  <!-- 3. Writing -->
  {% assign essays = home.essays %}
  <section class="home-writing home-sect" aria-labelledby="home-writing">
    <div class="home-head">
      <div>
        <div class="home-label home-r">{{ essays.label }}</div>
        <h2 class="home-r" id="home-writing" style="--d: 0.1s">{{ essays.title }}</h2>
      </div>
      <a class="home-quiet home-r" style="--d: 0.2s" href="{{ '/blog/' | relative_url }}">{{ essays.all }} →</a>
    </div>
    <ul class="home-shelf home-r" style="--d: 0.2s">
      {% for e in essays.posts %}
        {% assign needle = '_posts/' | append: e.file | append: '.md' %}
        {% assign p = site.posts | where: 'path', needle | first %}
        {% if p %}
          <li style="--i: {{ forloop.index0 }}">
            <a href="{{ p.url | relative_url }}">
              {% assign words = p.content | strip_html | number_of_words %}
              {% assign mins = words | plus: 199 | divided_by: 200 %}
              <span class="home-shelf__yr">{{ p.date | date: '%Y' }}<small>{{ mins }} min</small></span>
              <span class="home-shelf__body">
                <span class="home-shelf__t">{{ p.title }}</span>
                <span class="home-shelf__q">“{{ e.quote }}”</span>
              </span>
              <span class="home-shelf__tag">{{ e.topic }}</span>
            </a>
          </li>
        {% endif %}
      {% endfor %}
    </ul>
  </section>

  <!-- 4. Music, films & games -->
  {% assign play = home.play %}
  <section class="home-play home-sect" aria-labelledby="home-play">
    <div class="home-head home-head--split">
      <div>
        <div class="home-label home-r">{{ play.label }}</div>
        <h2 class="home-r" id="home-play" style="--d: 0.1s">{{ play.title }}</h2>
      </div>
      <p class="home-head__aside home-r" style="--d: 0.2s">{{ play.line }}</p>
    </div>
    <div class="home-bento">
      <a class="home-tile home-tile--music home-r" style="--d: 0.15s" href="{{ play.music.url | relative_url }}">
        <span class="home-tile__top">
          <span class="home-eq" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i></span>
          <span class="home-tile__go">{{ play.music.go }} →</span>
        </span>
        <span class="home-tile__big home-zh" lang="zh">{{ play.music.title }}</span>
        {% if play.music.cover %}
          <span class="home-sleeve" aria-hidden="true">
            <span class="home-sleeve__disc"></span>
            <img src="{{ '/assets/img/' | append: play.music.cover | relative_url }}" alt="" width="640" height="640" loading="lazy" decoding="async">
          </span>
        {% endif %}
        <span class="home-tile__cap">
          <span class="home-tile__kind">{{ play.music.kind }}</span>
          <span class="home-tile__line">{{ play.music.line }}</span>
        </span>
      </a>
      <a class="home-tile home-tile--film home-r" style="--d: 0.25s" href="{{ play.film.url | relative_url }}">
        {% if play.film.still %}
          <span class="home-still" aria-hidden="true">
            <img src="{{ '/assets/img/' | append: play.film.still | relative_url }}" alt="" width="360" height="640" loading="lazy" decoding="async">
            <span class="home-still__play">▶</span>
          </span>
        {% endif %}
        <span class="home-tile__cap">
          <span class="home-tile__kind">{{ play.film.kind }}</span>
          <span class="home-tile__t">{{ play.film.title }}</span>
          <span class="home-tile__line">{{ play.film.line }}</span>
          <span class="home-tile__go">{{ play.film.go }} →</span>
        </span>
      </a>
      <a class="home-tile home-tile--games home-r" style="--d: 0.35s" href="{{ play.games.url | relative_url }}">
        <span class="home-fan" aria-hidden="true">
          {% for img in play.games.images %}
            <img src="{{ '/assets/img/games/' | append: img | append: '.jpg' | relative_url }}" alt="" width="660" height="495" loading="lazy" decoding="async">
          {% endfor %}
        </span>
        <span class="home-tile__cap">
          <span class="home-tile__kind">{{ play.games.kind }}</span>
          <span class="home-tile__t">{{ play.games.title }}</span>
          <span class="home-tile__go">{{ play.games.go }} →</span>
        </span>
      </a>
    </div>
  </section>

  <!-- 5. Elsewhere -->
  <section class="home-elsewhere home-sect" aria-labelledby="home-elsewhere">
    <div class="home-label home-r">{{ home.elsewhere.label }}</div>
    <h2 class="home-r" id="home-elsewhere" style="--d: 0.1s">{{ home.elsewhere.title }}</h2>
    {% if home.elsewhere.line %}<p class="home-elsewhere__line home-r" style="--d: 0.15s">{{ home.elsewhere.line }}</p>{% endif %}
    {% if home.elsewhere.button %}
      <a class="home-btn home-btn--solid home-r" style="--d: 0.2s" href="{{ home.elsewhere.button.url }}">{{ home.elsewhere.button.text }} <span aria-hidden="true">→</span></a>
    {% endif %}
  </section>
</div>

<script defer src="{{ '/assets/js/home.js' | relative_url | bust_file_cache }}"></script>
