  gem "jekyll-get-json"
  gem "jekyll-link-attributes"
  gem "jekyll-paginate-v2", "~> 3.0"
  gem "jekyll-regex-replace"
  gem "jekyll-scholar", "~> 7.1"
  gem "jekyll-sitemap", "~> 1.4"
  gem "jekyll-tabs"
  gem "jekyll-toc"
  gem "jemoji", "~> 0.13"
end

